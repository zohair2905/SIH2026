# Runtime
APP_ENV=development
LOG_LEVEL=INFO

# Authentication / sessions
# Demo investigator password (required by the seed). Any password works for
# the seeded demo login; set a strong value outside of development.
DEMO_PASSWORD=change-me
# Opaque session-token lifetime in hours
ACCESS_TOKEN_TTL_HOURS=12
# Cookie used by the API and forwarded by the Next.js auth proxy
SESSION_COOKIE_NAME=sih_access_token
# Production only: send the session cookie over HTTPS only
AUTH_COOKIE_SECURE=false

# Cross-origin API clients (browser -> FastAPI directly). The Next.js app is
# same-origin and does not require CORS entries.
CORS_ORIGINS=http://localhost:3000

# PostgreSQL / PostGIS (local target DB via docker-compose)
POSTGRES_DB=sihdb
POSTGRES_USER=sih
POSTGRES_PASSWORD=sih
POSTGRES_PORT=5432

# Used from Phase 1 (persistence migration) onward; Phase 0 still runs on SQLite.
DATABASE_URL=postgresql+psycopg://sih:sih@localhost:5432/sihdb